<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear nuevo envío"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etTamano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tamaño estimado (Ej. Mediano)"/>

    <EditText
        android:id="@+id/etPeso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Peso aproximado (Ej. Hasta 2 kg)"/>

    <EditText
        android:id="@+id/etCelularComprador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Celular del Comprador"
        android:inputType="phone"/>

    <Button
        android:id="@+id/btnCrearEnvio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear envío"
        android:layout_marginTop="24dp"/>

</LinearLayout>